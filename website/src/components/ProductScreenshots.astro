---
import type { Locale } from '../content/site-copy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const screenshots = [
  { id: 'todos', label: en ? 'Todos' : '待办', caption: en ? 'A place for the things you want to get done.' : '想到的事，记下就不怕忘。', alt: en ? 'Floatick todo list with everyday tasks, due dates, and shared tags.' : 'Floatick 中文待办列表，展示准备会议、取快递等日常任务、截止时间和彩色标签。' },
  { id: 'notes', label: en ? 'Notes' : '笔记', caption: en ? 'Ideas, plans, and little things worth keeping.' : '灵感和日常，随手留一份。', alt: en ? 'Floatick notes with a pinned weekend plan and meeting notes.' : 'Floatick 中文笔记列表，展示置顶的周末计划和会议笔记。' },
  { id: 'editor', label: en ? 'Writing' : '写作', caption: en ? 'A little structure when you need more than a title.' : '展开细节，把想法慢慢写完整。', alt: en ? 'Floatick editor showing meeting preparation with headings and an interactive checklist.' : 'Floatick 中文编辑器，展示会议准备笔记、标题和可勾选的清单。' },
];
---

<div class="product-showcase" data-showcase>
  <div class="showcase-scene">
    <div class="menubar-preview" aria-hidden="true">
      <div class="menubar-items">
        <span class="menubar-tray">
          <span class="menubar-app-icon"></span><span>4</span>
        </span>
        <span class="menubar-symbol menubar-battery" style="--symbol: url('/images/menubar/battery.png')"></span>
        <span class="menubar-symbol" style="--symbol: url('/images/menubar/wifi.png')"></span>
        <span class="menubar-symbol menubar-spotlight" style="--symbol: url('/images/menubar/spotlight.png')"></span>
        <span class="menubar-symbol" style="--symbol: url('/images/menubar/control-center.png')"></span>
        <span class="menubar-clock"><span class="menubar-date">{en ? 'Sat Sep 5' : '9月5日 周六'}</span><span>09:41</span></span>
      </div>
    </div>
    <div class="screenshot-panels">
      {screenshots.map((item, index) => (
        <figure class="screenshot-panel" id={`preview-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} tabindex="0" hidden={index !== 0}>
          <div class="screenshot-image">
            <img src={`/images/product-${item.id}-${locale}.png`} alt={item.alt} width="440" height="700" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
          </div>
          <figcaption>{item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="showcase-tabs" role="tablist" aria-label={en ? 'Explore the app' : '切换产品界面'}>
    {screenshots.map((item, index) => <button type="button" role="tab" id={`tab-${item.id}`} aria-controls={`preview-${item.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-preview={item.id}>{item.label}</button>)}
  </div>
  <noscript><style>[data-showcase] .showcase-tabs{display:none}[data-showcase] [role="tabpanel"][hidden]{display:block}[data-showcase] .screenshot-panels{display:grid;gap:24px}</style></noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((showcase) => {
    const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...showcase.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    // Keep the popover pointer under the real tray icon at every viewport size.
    const tray = showcase.querySelector<HTMLElement>('.menubar-tray');
    const frame = showcase.querySelector<HTMLElement>('.screenshot-panels');
    const positionPointer = () => {
      if (!tray || !frame) return;
      const anchor = tray.getBoundingClientRect();
      frame.style.setProperty('--tray-x', `${anchor.x + anchor.width / 2 - frame.getBoundingClientRect().x}px`);
    };
    if ('ResizeObserver' in window) new ResizeObserver(positionPointer).observe(showcase);
    document.fonts.ready.then(positionPointer);
    positionPointer();
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(next, true);
      });
    });
  });
</script>

<style>
  .product-showcase { width: 100%; max-width: 494px; justify-self: end; min-width: 0; container-type: inline-size; }
  .showcase-scene { position: relative; padding-bottom: 0; isolation: isolate; }
  .showcase-scene::before { content: ''; position: absolute; z-index: -1; inset: 2% -5% 2%; background: radial-gradient(ellipse at 50% 40%, rgba(75, 153, 135, .13), transparent 68%); pointer-events: none; }
  .menubar-preview {
    position: relative;
    display: flex;
    justify-content: flex-end;
    height: 28px;
    padding-right: 12px;
    margin-bottom: 13px;
    color: #f4f5f6;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }
  /* A cropped right edge of the desktop, rather than a separate toolbar card. */
  .menubar-preview::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 0 10px 0 0;
    background: linear-gradient(90deg, rgba(131, 150, 149, 0), rgba(131, 150, 149, .18) 23%, rgba(153, 166, 164, .24));
    box-shadow: 0 1px rgba(255,255,255,.07);
    backdrop-filter: blur(24px) saturate(1.25);
  }
  .menubar-items { display: flex; align-items: center; gap: 11px; height: 100%; }
  .menubar-tray { display: flex; align-items: center; gap: 4px; align-self: stretch; padding-inline: 8px; border-radius: 4px; background: rgba(255,255,255,.18); font-variant-numeric: tabular-nums; }
  .menubar-app-icon { width: 18px; height: 18px; display: block; background: currentColor; mask: url('/images/menubar/floatick.png') center / contain no-repeat; -webkit-mask: url('/images/menubar/floatick.png') center / contain no-repeat; }
  .menubar-symbol { display: block; flex-shrink: 0; width: 21px; height: 18px; background: currentColor; mask: var(--symbol) center / contain no-repeat; -webkit-mask: var(--symbol) center / contain no-repeat; }
  .menubar-battery { width: 27px; }
  .menubar-spotlight { width: 18px; }
  .menubar-clock { display: flex; gap: 9px; font-variant-numeric: tabular-nums; }
  .screenshot-panels { position: relative; width: min(100%, 334px); margin-left: auto; margin-right: 49px; }
  .screenshot-panels::before { content: ''; position: absolute; top: -5px; left: clamp(16px, var(--tray-x, 50%), calc(100% - 16px)); width: 10px; height: 10px; background: #1a1a1c; border-left: 1px solid rgba(255,255,255,.1); border-top: 1px solid rgba(255,255,255,.1); transform: translateX(-50%) rotate(45deg); z-index: 1; }
  .screenshot-panel { margin: 0; outline-offset: 5px; border-radius: 12px; }
  .screenshot-panel[hidden] { display: none; }
  /* Clip inside the screenshots' baked white corner matte at every display size. */
  .screenshot-image { overflow: hidden; border-radius: 14px; background: #1a1a1c; box-shadow: 0 22px 48px -18px rgba(0,0,0,.65); }
  .screenshot-panel img { display: block; width: 100%; height: auto; }
  .screenshot-panel figcaption { margin-top: 17px; text-align: center; color: var(--color-text-muted); font-size: 11px; line-height: 1.6; min-height: 36px; }
  .showcase-tabs { display: flex; width: fit-content; margin: 4px auto 0; padding: 4px; border: 1px solid var(--color-line); border-radius: 10px; background: #141c1e; gap: 3px; }
  .showcase-tabs button { appearance: none; min-width: 76px; min-height: 38px; padding: 8px 16px; border: 0; border-radius: 6px; background: transparent; color: var(--color-text-muted); cursor: pointer; font: inherit; font-size: 12px; transition: background-color 160ms, color 160ms; }
  .showcase-tabs button:hover { color: var(--color-text); background: #202c2d; }
  .showcase-tabs button[aria-selected="true"] { color: var(--color-text); background: #293638; box-shadow: 0 1px 3px rgba(0,0,0,.15); }
  @media (max-width: 1100px) { .screenshot-panels { width: min(100% - 48px, 320px); margin-right: 24px; } }
  @container (max-width: 365px) {
    .menubar-battery { display: none; }
    .menubar-items { gap: 9px; }
    .menubar-clock { gap: 7px; font-size: 11px; }
  }
  @media (max-width: 760px) {
    .product-showcase { justify-self: center; max-width: 420px; }
    .screenshot-panels { width: min(100% - 26px, 330px); margin-inline: auto; }
    .menubar-preview { margin-bottom: 13px; }
    .showcase-tabs button { min-height: 40px; }
    .screenshot-panel figcaption { font-size: 12px; }
  }
</style>
