---
import { siteCopy, type Locale } from '../content/site-copy';
import { latestDownloadUrl, repositoryUrl, stableRelease } from '../config/site-links';
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadIcon from './DownloadIcon.astro';
import ProductScreenshots from './ProductScreenshots.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = siteCopy[locale];
const isEnglish = locale === 'en';
const languageHref = isEnglish ? '/zh/' : '/';
const changelogHref = isEnglish ? '/changelog/' : '/zh/changelog/';
const featurePaths = [
  'M8 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2 M12 4h8 M16 0v8 M8 12h8 M8 16h5',
  'M14 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M14 4l3-3 4 4-9 9-5 1 1-5 6-6 M15 3l4 4',
  'M5 7h9 M5 12h6 M5 17h4 M15 16l3 3 5-6 M2 3v18',
];
---

<SiteLayout
  lang={copy.meta.lang}
  title={copy.meta.title}
  description={copy.meta.description}
  canonicalPath={copy.meta.canonicalPath}
  alternatePath={copy.meta.alternatePath}
  softwareVersion={stableRelease.version}
  faqItems={copy.faq.items}
>
  <a class="skip-link" href="#main">{isEnglish ? 'Skip to content' : '跳转到正文'}</a>
  <header class="site-header">
    <nav class="nav shell" aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
      <a class="brand" href={copy.meta.canonicalPath} aria-label={isEnglish ? 'Floatick home' : 'Floatick 首页'}>
        <img src="/favicon.png" alt="" width="34" height="34" />
        <span>Floatick</span>
      </a>
      <div class="nav-links">
        <a href="#features">{copy.nav.features}</a>
        <a href="#privacy">{copy.nav.privacy}</a>
        <a href={changelogHref}>{copy.nav.changelog}</a>
      </div>
      <div class="nav-actions">
        <a class="language-link" href={languageHref} lang={isEnglish ? 'zh-CN' : 'en'} hreflang={isEnglish ? 'zh-CN' : 'en'} aria-label={copy.nav.languageLabel}>
          <span class="language-mark" aria-hidden="true"></span>
          <span>{isEnglish ? '中文' : 'EN'}</span>
        </a>
        <a class="button button-compact button-download" href={latestDownloadUrl}>
          <DownloadIcon />{copy.nav.download}
        </a>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span aria-hidden="true"></span>{copy.hero.eyebrow}</p>
        <h1 id="hero-title">
          <span>{copy.hero.titleBefore}</span>
          <span class="hero-title-accent">{copy.hero.titleAccent}</span>
        </h1>
        <p class="hero-body">{copy.hero.body}<span>{copy.hero.detail}</span></p>
        <div class="hero-actions">
          <a class="button button-primary button-download" href={latestDownloadUrl}><DownloadIcon />{copy.hero.download}</a>
          <a class="text-link source-link" href={repositoryUrl} target="_blank" rel="noreferrer">{copy.hero.github}<span aria-hidden="true">↗</span></a>
        </div>
        <p class="compatibility">{copy.hero.compatibility}</p>
        <a class="release-note" href="#version-answer">{copy.hero.releaseNote}<span aria-hidden="true">↗</span></a>
        <ul class="hero-facts" aria-label={isEnglish ? 'Product facts' : '产品信息'}>
          {copy.hero.facts.map((fact) => <li><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>{fact}</li>)}
        </ul>
      </div>
      <ProductScreenshots locale={locale} />
    </section>

    <section class="section features-section shell" id="features" aria-labelledby="features-title">
      <div class="section-heading">
        <p class="eyebrow">{copy.features.eyebrow}</p>
        <h2 id="features-title">{copy.features.title}</h2>
      </div>
      <div class="feature-grid">
        {copy.features.items.map((feature, index) => (
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true"><svg viewBox="-2 -2 28 28" fill="none"><path d={featurePaths[index]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <span class="feature-detail">{feature.detail}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section privacy-section shell" id="privacy" aria-labelledby="privacy-title">
      <div class="privacy-grid">
        <div class="privacy-copy">
          <p class="eyebrow">{copy.privacy.eyebrow}</p>
          <h2 id="privacy-title">{copy.privacy.title}</h2>
          <p class="privacy-body">{copy.privacy.body}</p>
          <ul class="privacy-points">{copy.privacy.points.map((point) => <li>{point}</li>)}</ul>
          <a class="text-link" href={repositoryUrl} target="_blank" rel="noreferrer">{copy.privacy.source}<span aria-hidden="true">↗</span></a>
        </div>
        <figure class="storage-figure">
          <div class="folder-heading">
            <svg class="folder-icon" viewBox="0 0 32 28" fill="none" aria-hidden="true"><path d="M3 5a3 3 0 0 1 3-3h6l4 4h10a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V5Z" fill="currentColor" fill-opacity=".14" stroke="currentColor" stroke-width="1.3"/><path d="M3 10h26" stroke="currentColor" stroke-width="1.3"/></svg>
            <code>~/.floatick</code>
            <span class="local-dot" aria-label={isEnglish ? 'Local storage' : '本地存储'}></span>
          </div>
          <ul class="storage-files" aria-label={isEnglish ? 'Local data files' : '本地数据文件'}>
            {['todos.json', 'notes.json', 'tags.json', 'settings.json'].map((file) => <li><svg viewBox="0 0 16 18" fill="none" aria-hidden="true"><path d="M3 1h6l4 4v12H3V1Z M9 1v4h4 M5.5 9h5 M5.5 12h4" stroke="currentColor" stroke-linejoin="round" /></svg><code>{file}</code><span>JSON</span></li>)}
          </ul>
          <figcaption>{copy.privacy.note}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section faq-section shell" id="faq" aria-labelledby="faq-title">
      <div class="section-heading">
        <p class="eyebrow">{copy.faq.eyebrow}</p>
        <h2 id="faq-title">{copy.faq.title}</h2>
      </div>
      <div class="faq-list">
        {copy.faq.items.map((item, index) => (
          <details class="faq-item" id={index === 0 ? 'version-answer' : undefined}>
            <summary><span>{item.question}</span><span class="faq-toggle" aria-hidden="true">+</span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta shell" aria-labelledby="download-title">
      <img src="/favicon.png" alt="" width="48" height="48" loading="lazy" />
      <h2 id="download-title">{copy.finalCta.title}</h2>
      <p>{copy.finalCta.body}</p>
      <a class="button button-primary button-download" href={latestDownloadUrl}><DownloadIcon />{copy.finalCta.download}</a>
      <div class="final-release"><span>{copy.finalCta.releaseNote}</span><a href={changelogHref}>{copy.finalCta.changelog}<span aria-hidden="true">↗</span></a></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-content">
      <div class="footer-brand"><strong>Floatick</strong><p>{copy.footer.tagline}</p></div>
      <div class="footer-links">
        <a href={repositoryUrl} target="_blank" rel="noreferrer">{copy.footer.source}</a>
        <a href={changelogHref}>{copy.nav.changelog}</a>
        <a href={`${repositoryUrl}/blob/main/LICENSE`} target="_blank" rel="noreferrer">{copy.footer.license}</a>
        <a href={languageHref} lang={isEnglish ? 'zh-CN' : 'en'}>{copy.footer.language}</a>
      </div>
    </div>
  </footer>
</SiteLayout>

<script>
  // Linking to the version explanation should also reveal its contents.
  const revealVersion = () => {
    if (window.location.hash !== '#version-answer') return;
    const answer = document.querySelector<HTMLDetailsElement>('#version-answer');
    if (answer) answer.open = true;
  };
  window.addEventListener('hashchange', revealVersion);
  revealVersion();
</script>
