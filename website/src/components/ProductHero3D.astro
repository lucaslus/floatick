---
import type { Locale } from '../content/site-copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const demoCopy = {
  en: {
    ariaLabel:
      'Interactive three-dimensional Floatick workspace showing Todos, Notes, deadlines, and the macOS Menu Bar status extra',
    remaining: '13 tasks remaining',
    todosTab: 'Todos',
    notesTab: 'Notes',
    search: 'Search',
    today: 'Today',
    tasks: [
      { title: 'Review the launch checklist', tag: 'Work', time: '09:10' },
      { title: 'Polish the product story', tag: 'Focus', time: '11:30' },
      { title: 'Send the release notes', tag: 'Launch', time: '16:20' },
    ],
    overdueLabel: 'Overdue',
    drawerTitle: 'Set deadline',
    calendarMonth: 'September 2026',
    calendarWeekdays: ['S', 'M', 'T', 'W', 'T', 'F', 'S'],
    deadlineLabel: 'Deadline',
    dueDate: 'Sep 12, 2026',
    dueTime: '18:30',
    reminderLabel: 'Reminder',
    reminderValue: 'At deadline',
    save: 'Save',
  },
  zh: {
    ariaLabel:
      'Floatick 菜单栏应用预览，展示待办、笔记、截止时间和 macOS 菜单栏图标',
    remaining: '还有 13 项没完成',
    todosTab: '待办',
    notesTab: '笔记',
    search: '搜索',
    today: '今天',
    tasks: [
      { title: '检查发布清单', tag: '工作', time: '09:10' },
      { title: '完善产品介绍', tag: '专注', time: '11:30' },
      { title: '发送版本说明', tag: '发布', time: '16:20' },
    ],
    overdueLabel: '已逾期',
    drawerTitle: '设置截止时间',
    calendarMonth: '2026 年 9 月',
    calendarWeekdays: ['日', '一', '二', '三', '四', '五', '六'],
    deadlineLabel: '截止时间',
    dueDate: '2026 年 9 月 12 日',
    dueTime: '18:30',
    reminderLabel: '提醒',
    reminderValue: '到期时提醒',
    save: '保存',
  },
} as const;

const copy = demoCopy[locale];
---

<div
  class="product-hero-stage"
  data-product-scene
  data-remaining={copy.remaining}
  data-todos-tab={copy.todosTab}
  data-notes-tab={copy.notesTab}
  data-search={copy.search}
  data-today={copy.today}
  data-task-one-title={copy.tasks[0].title}
  data-task-one-tag={copy.tasks[0].tag}
  data-task-one-time={copy.tasks[0].time}
  data-task-two-title={copy.tasks[1].title}
  data-task-two-tag={copy.tasks[1].tag}
  data-task-two-time={copy.tasks[1].time}
  data-task-three-title={copy.tasks[2].title}
  data-task-three-tag={copy.tasks[2].tag}
  data-task-three-time={copy.tasks[2].time}
  data-overdue-label={copy.overdueLabel}
  data-drawer-title={copy.drawerTitle}
  data-calendar-month={copy.calendarMonth}
  data-calendar-weekdays={copy.calendarWeekdays.join('|')}
  data-deadline-label={copy.deadlineLabel}
  data-due-date={copy.dueDate}
  data-due-time={copy.dueTime}
  data-reminder-label={copy.reminderLabel}
  data-reminder-value={copy.reminderValue}
  data-save={copy.save}
  role="img"
  aria-label={copy.ariaLabel}
>
  <canvas class="product-scene-canvas" data-product-scene-canvas aria-hidden="true"></canvas>
  <div class="product-scene-fallback" aria-hidden="true">
    <img
      src="/images/floatick-product-hero-v6.jpg"
      alt=""
      width="1600"
      height="800"
    />
  </div>
</div>

<script>
  const loadProductScene = async () => {
    const { initializeProductHeroScenes } = await import(
      '../scripts/product-hero-scene'
    );
    initializeProductHeroScenes();
  };

  const startProductScene = () => {
    void loadProductScene().catch((error: unknown) => {
      document
        .querySelector<HTMLElement>('[data-product-scene]')
        ?.classList.add('has-webgl-error');
      console.error('Floatick product scene module could not be loaded.', error);
    });
  };

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(startProductScene, { timeout: 450 });
  } else {
    window.setTimeout(startProductScene, 1);
  }
</script>
