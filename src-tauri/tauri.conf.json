{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Floatick",
  "version": "0.4.1",
  "identifier": "io.github.lucaslushuo.floatick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm setup:sparkle && pnpm dev",
    "beforeBuildCommand": "pnpm setup:sparkle && pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Floatick",
        "width": 440,
        "height": 700,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleVersion": "13",
      "frameworks": ["./Sparkle.framework"],
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
